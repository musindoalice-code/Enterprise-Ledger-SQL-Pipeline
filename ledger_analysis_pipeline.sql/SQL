-- STEP 3: Multi-Tiered CTE Analytical Analytical Pipeline for Corporate Audit Exceptions
WITH normalized_ledger AS (
    -- Subquery component: Standardizing string layouts and tracking velocity trends
    SELECT 
        transaction_id,
        invoice_id,
        vendor_name,
        -- Clean string boundaries for exact SQL matches where possible
        UPPER(TRIM(REPLACE(REPLACE(vendor_name, '.', ''), 'SA', ''))) as cleaned_vendor,
        amount_zar,
        invoice_date,
        approved_by,
        cost_center,
        -- Window function: Track running total velocity spent per cost center
        SUM(amount_zar) OVER(PARTITION BY cost_center ORDER BY invoice_date) as cost_center_running_total
    FROM general_ledger
),
velocity_risk_signals AS (
    -- Window Function component: Identifying sequential multi-day transactional grouping
    SELECT 
        transaction_id,
        invoice_id,
        vendor_name,
        cleaned_vendor,
        amount_zar,
        invoice_date,
        approved_by,
        -- Check if previous row had identical amount to identify split payments or system errors
        LAG(amount_zar, 1) OVER(PARTITION BY cleaned_vendor ORDER BY invoice_date) as prev_amount,
        LAG(invoice_date, 1) OVER(PARTITION BY cleaned_vendor ORDER BY invoice_date) as prev_date
    FROM normalized_ledger
)
-- STEP 4: High-Value Materiality Isolation & Potential Approval Bypass Output
SELECT 
    transaction_id,
    invoice_id,
    vendor_name,
    amount_zar,
    invoice_date,
    approved_by,
    CASE 
        WHEN amount_zar == prev_amount AND ABS(JULIANDAY(invoice_date) - JULIANDAY(prev_date)) <= 2 THEN 'CRITICAL RISK: Potential Duplicate/Split Invoice'
        WHEN amount_zar >= 45000.00 AND approved_by = 'SYSTEM_AUTO' THEN 'WARNING: High-Value System Auto Approval'
        ELSE 'Review Required - Threshold Variance'
    END AS risk_classification
FROM velocity_risk_signals
WHERE amount_zar >= 10000.00;

